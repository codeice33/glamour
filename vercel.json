{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": null,
  "outputDirectory": null,
  "functions": {
    "api/*.php": {
      "runtime": "vercel-php@0.7.4"
    }
  },
  "routes": [
    { "src": "/glamour/(.*)", "dest": "/glamour/$1" },
    { "src": "/dashboard", "dest": "/api/dashboard.php" },
    { "src": "/dashboard.php", "dest": "/api/dashboard.php" },
    { "src": "/register", "dest": "/api/register.php" },
    { "src": "/register.php", "dest": "/api/register.php" },
    { "src": "/", "dest": "/api/index.php" },
    { "src": "/index.php", "dest": "/api/index.php" },
    { "src": "/(.*)", "dest": "/api/index.php" }
  ]
}
